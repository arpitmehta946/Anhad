.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
*.g.dart
*.isar

# android/ is tracked (unlike the other platform folders below) — the
# screen-off japa feature (docs/PRD.md §7.4) added real hand-written native
# code (JapaForegroundService.kt, manifest permissions, MainActivity's
# platform channel) that `flutter create` can't regenerate. The wrapper
# jar, local.properties, keystores etc. underneath it are already handled
# by the nested android/.gitignore flutter create generated — this only
# adds what that one doesn't cover.
/android/app/build/
/android/build/

# Platform folders below are still the untouched `flutter create .`
# scaffold — generated, environment-specific, kept out of the diff until
# (if ever) they get real custom code the way android/ now has.
/ios/
/linux/
/macos/
/windows/
/web/

*.iml
.idea/
.vscode/

# `flutter test` runs as a plain Dart VM process on the host, not through a
# full `flutter run -d windows` build, so the isar_community_flutter_libs
# plugin's CMake step (which normally copies this next to the built exe)
# never runs — Isar.open() looks for it directly in the working directory
# instead. Copied once from the pub cache:
#   cp "$LOCALAPPDATA/Pub/Cache/hosted/pub.dev/isar_community_flutter_libs-<version>/windows/libisar.dll" mobile/libisar.dll
# A prebuilt binary tied to the isar_community version, not source — same
# reasoning as *.g.dart above, just gitignored instead of vendored.
/libisar.dll
