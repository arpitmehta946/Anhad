API_ADDR=:8080
APP_ENV=development
DATABASE_URL=postgres://anhad:anhad@localhost:5432/anhad?sslmode=disable
REDIS_URL=redis://localhost:6379/0
# JWT signing secret. The dev fallback in config.go only works when
# APP_ENV=development — every other environment must set this explicitly.
JWT_SECRET=dev-insecure-jwt-secret-change-me
# First-admin bootstrap (docs/GAPS.md "Roles & permissions"): the phone
# number here gets role = admin automatically the moment it signs up.
# Empty/unset means the mechanism is a no-op. E.g. BOOTSTRAP_ADMIN_PHONE=+919812345678
BOOTSTRAP_ADMIN_PHONE=
# Reel video storage (docs/TECH_STACK.md §3). "local" is a disk-backed
# stand-in for Cloudflare Stream — no Cloudflare account needed to build
# and test the upload/feed flow. "cloudflare" isn't implemented yet.
VIDEO_STORAGE_BACKEND=local
# Where the local backend writes uploaded video files. Unused otherwise.
LOCAL_UPLOAD_DIR=./data/uploads
# How a client reaches this API — used to build the local backend's own
# upload/playback URLs, so it must be reachable from whatever device runs
# the mobile app, not just from this process. Match whatever API_BASE_URL
# the app is running with (mobile/lib/src/config.dart) — e.g. your PC's
# LAN IP for a physical device over WiFi, 10.0.2.2 for the Android
# emulator, or leave the localhost default for `adb reverse`.
PUBLIC_BASE_URL=http://localhost:8080

# The three-layer moderation pipeline (docs/PRD.md §8.1, internal/moderation).
# Each layer is its own backend switch since each needs a different (or no)
# external account.

# ffmpeg pulls the audio track out of an uploaded video. No account, just
# needs installing — leave as "ffmpeg" if it's on PATH, or point at a full
# path.
FFMPEG_PATH=ffmpeg

# "local" (default): self-hosted whisper.cpp, free, no account, runs on
# CPU. Needs WHISPER_CLI_PATH (the whisper-cli binary) and
# WHISPER_MODEL_PATH (a ggml model file, e.g. ggml-small.bin from
# https://huggingface.co/ggerganov/whisper.cpp). "openai" uses the Whisper
# API instead (needs OPENAI_API_KEY) — a one-line config change if local
# transcription accuracy on sung Hindi/Sanskrit turns out too weak.
TRANSCRIBER_BACKEND=local
WHISPER_CLI_PATH=whisper-cli
WHISPER_MODEL_PATH=
OPENAI_API_KEY=

# "keyword" (default): a crude dev-only heuristic — NOT a real substitute
# for the classifier (docs/PRD.md §8.1 is explicit that a keyword list
# alone can't make this judgment). "claude" and "gemini" are both the real
# thing (identical prompt, so results are comparable) — pick whichever
# you can actually pay for; Anthropic's API doesn't accept Indian payment
# methods as of this writing, Gemini's free tier does.
CLASSIFIER_BACKEND=keyword
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# "none" (default): always reports no match — there's no free, reliable
# commercial-catalog fingerprint DB to stub against honestly. "acrcloud"
# isn't implemented yet (needs an ACRCloud account to build and verify
# against).
FINGERPRINT_BACKEND=none
ACRCLOUD_HOST=
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_SECRET_KEY=
