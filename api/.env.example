API_ADDR=:8080
APP_ENV=development
DATABASE_URL=postgres://anhad:anhad@localhost:5432/anhad?sslmode=disable
REDIS_URL=redis://localhost:6379/0
# JWT signing secret. The dev fallback in config.go only works when
# APP_ENV=development — every other environment must set this explicitly.
JWT_SECRET=dev-insecure-jwt-secret-change-me
# First-admin bootstrap (docs/GAPS.md "Roles & permissions"): the phone
# number here gets role = admin automatically the moment it signs up.
# Empty/unset means the mechanism is a no-op. E.g. BOOTSTRAP_ADMIN_PHONE=+919812345678
BOOTSTRAP_ADMIN_PHONE=
